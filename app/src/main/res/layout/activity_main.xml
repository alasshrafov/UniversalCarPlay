<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- 1. CarPlay Video Göstərici Təbəqəsi (Aşağı Gecikməli SurfaceView) -->
    <com.universal.carplay.ui.CarPlaySurfaceView
        android:id="@+id/surfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- 2. Lüks Avtomobil Qoşulma Mərkəzi (Bağlantı Olmayanda Görünür) -->
    <LinearLayout
        android:id="@+id/statusOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:background="@drawable/bg_card"
        android:elevation="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="12dp"
                android:indeterminateTint="@color/car_accent" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CarTwin 2.0 • Universal Qoşulma"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- CarTwin 2.0 İkili Platforma Kartları (CarPlay & Android Auto) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <!-- Platforma 1: Apple CarPlay -->
            <LinearLayout
                android:layout_width="230dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:background="#141B2D"
                android:padding="16dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🍏 Apple CarPlay"
                    android:textColor="#30D158"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="iPhone kabel və ya Carlinkit adapterinə qoşulan kimi Apple CarPlay interfeysi, Waze, Apple Music və zənglər avtomatik açılır."
                    android:textColor="@color/car_text_gray"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>

            <!-- Platforma 2: Android Auto -->
            <LinearLayout
                android:layout_width="230dp"
                android:layout_height="wrap_content"
                android:background="#141B2D"
                android:padding="16dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🤖 Android Auto"
                    android:textColor="#00F0FF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Samsung, Xiaomi, Pixel və s. qoşulan kimi Android Auto, Google Maps, Spotify və Azərbaycan dilli Aura AI səs köməkçisi aktivləşir."
                    android:textColor="@color/car_text_gray"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Canlı Telemetriya Məlumatı -->
        <TextView
            android:id="@+id/tvDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Bluetooth: CarTwin • Server: Port 7000 • USB: Gözlənilir"
            android:textColor="@color/car_text_gray"
            android:textSize="13sp" />

        <!-- Yeniləmə / Reset Düyməsi -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnRefreshConnection"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔄 Xidmətləri Yenidən Başlat"
                android:textColor="@color/car_accent"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnConnectMock"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="🧪 PC Simulyatoru"
                android:textColor="#64748B"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 3. Avtomobil Profil və Tənzimləmə Paneli (Yuxarı Künc) -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivTopBarLogo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/ic_logo_byd"
            android:contentDescription="Car Brand" />

        <TextView
            android:id="@+id/tvCurrentProfile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Profil: BYD DiLink"
            android:textColor="@color/car_text_gray"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCheckUpdate"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚀 OTA Yeniləmə"
            android:textColor="#30D158"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnOpenBrowser"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌐 Brauzer &amp; Video"
            android:textColor="#FF30D158"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnReplayIntro"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎬 Loqo Şousu"
            android:textColor="@color/car_accent" />

        <Button
            android:id="@+id/btnSettings"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚙️ Brend Dəyiş"
            android:textColor="@color/white" />
    </LinearLayout>

    <!-- 4. Lüks Reklam Çarxı Stilində Açılış Şousu Overlay (İstifadəçinin xüsusi istəyi ilə) -->
    <FrameLayout
        android:id="@+id/commercialSplashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_commercial_gradient"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:id="@+id/commercialCenterContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Arxada İşıqlı Neon Hələqə və Mərkəzi Orijinal Loqo -->
            <FrameLayout
                android:layout_width="320dp"
                android:layout_height="170dp">

                <View
                    android:id="@+id/viewGlowAura"
                    android:layout_width="300dp"
                    android:layout_height="170dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_glow_aura" />

                <ImageView
                    android:id="@+id/ivCommercialLogo"
                    android:layout_width="260dp"
                    android:layout_height="130dp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_logo_byd"
                    android:contentDescription="Avtomobil Loqosu" />
            </FrameLayout>

            <!-- Böyük Metalik/Neon Brend Başlığı -->
            <TextView
                android:id="@+id/tvCommercialTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="BUILD YOUR DREAMS"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <!-- Lüks Alt Başlıq / Sloqan -->
            <TextView
                android:id="@+id/tvCommercialTagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="BYD DILINK 5.0 • ULTRA SMART COCKPIT"
                android:textColor="#00F0FF"
                android:textSize="12sp"
                android:letterSpacing="0.1" />

            <!-- Sistem Statusu -->
            <TextView
                android:id="@+id/tvCommercialStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="⚡ CARPLAY AVTOMATİK AKTİVLƏŞDİRİLİR…"
                android:textColor="@color/car_text_gray"
                android:textSize="11sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- 5. İnteqrasiya Olunmuş Avtomobil İnternet Brauzeri və Multimedia Veb Pəncərəsi -->
    <LinearLayout
        android:id="@+id/browserOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#FF0B0F19"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <!-- Brauzer Alətlər Zolağı -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#FF161D2E"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnBrowserBack"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:text="◀"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnBrowserForward"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:text="▶"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnBrowserRefresh"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:text="🔄"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <!-- Sürətli Qısayollar -->
            <Button
                android:id="@+id/btnQuickGoogle"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Google"
                android:textColor="#FF0A84FF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnQuickYouTube"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YouTube"
                android:textColor="#FFFF453A"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnQuickWiki"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wiki"
                android:textColor="#FF30D158"
                android:textSize="12sp" />

            <!-- URL Giriş Sahəsi -->
            <EditText
                android:id="@+id/etBrowserUrl"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/bg_card"
                android:hint="Axtarın və ya URL daxil edin…"
                android:textColorHint="@color/car_text_gray"
                android:textColor="@color/white"
                android:paddingHorizontal="14dp"
                android:textSize="13sp"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:singleLine="true" />

            <Button
                android:id="@+id/btnBrowserGo"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Keç"
                android:textSize="12sp"
                android:backgroundTint="@color/car_accent"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/btnBrowserClose"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="✕ Bağla"
                android:textColor="#FFFF453A"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/browserProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:progressTint="@color/car_accent"
            android:visibility="gone" />

        <WebView
            android:id="@+id/webViewBrowser"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>

</FrameLayout>
